---
import ToolPage from '../layouts/ToolPage.astro';
import FileDropzone from '../components/FileDropzone.astro';
import { IMAGE_ACCEPT } from '../scripts/image-load';

const steps = [
	'Tap the box and choose your pictures. Photos of documents, scans and screenshots all work, and you can add more later.',
	'Use the ↑ and ↓ buttons to put them in the right order. Each picture becomes one page.',
	'Choose the page size, then press Make PDF and Download.',
];

const faq = [
	{
		q: 'Are my pictures uploaded anywhere?',
		a: 'No. The PDF is made inside your browser, on your own device. Your pictures are never sent to HandyQuill or anyone else.',
	},
	{
		q: 'Which picture types work?',
		a: 'JPG, PNG, WebP, GIF, BMP and AVIF, wherever your browser can open them. iPhone HEIC photos only work in Safari. On an iPhone, you can choose Settings, Camera, Formats, Most Compatible so new photos are saved as JPG.',
	},
	{
		q: 'Which page size should I choose?',
		a: 'A4 is the normal size in Nigeria and most of the world, and Letter is used in the USA and Canada. "Fit to picture" makes each page exactly the shape of its picture, with no white border, which suits screenshots and scans that must not be cropped.',
	},
	{
		q: 'Will my phone photos come out the right way up?',
		a: 'Yes. Photos taken in portrait or landscape are turned the way you saw them. With "Automatic" orientation, a wide picture gets a wide page and a tall picture gets a tall page.',
	},
	{
		q: 'Why is the PDF too big for the portal?',
		a: 'Choose "Smaller file" under picture quality, or make the pictures smaller first with the Compress Image tool. You can also shrink the finished PDF with the Compress PDF tool.',
	},
	{
		q: 'Can I turn a PDF back into pictures, or edit the text?',
		a: 'Not with this tool. It only makes PDFs from pictures. The words inside a picture stay a picture, so they cannot be selected or searched in the PDF.',
	},
	{
		q: 'Is there a limit?',
		a: 'Up to 50 pictures in one PDF, up to 40 MB each and 300 MB in total. If you have more, make the PDF in two parts and join them with the Merge PDF tool.',
	},
];
---

<ToolPage
	slug="images-to-pdf"
	intro="Turn photos, scans and screenshots into one PDF, in the order you choose. Free, with no sign-up."
	steps={steps}
	faq={faq}
>
	<FileDropzone id="file-input" accept={IMAGE_ACCEPT} multiple title="Tap to choose pictures" />

	<ul class="results" id="file-list"></ul>

	<div id="options" class="hidden">
		<div class="options spaced">
			<label class="field">
				<span>Page size</span>
				<select id="page-size">
					<option value="a4" selected>A4</option>
					<option value="letter">Letter (USA)</option>
					<option value="fit">Fit to picture (no border)</option>
				</select>
			</label>
			<label class="field" id="orientation-field">
				<span>Page direction</span>
				<select id="orientation">
					<option value="auto" selected>Automatic</option>
					<option value="portrait">Tall (portrait)</option>
					<option value="landscape">Wide (landscape)</option>
				</select>
			</label>
			<label class="field" id="margin-field">
				<span>White border</span>
				<select id="margin">
					<option value="none">None</option>
					<option value="small" selected>Small</option>
					<option value="normal">Normal</option>
				</select>
			</label>
			<label class="field">
				<span>Picture quality</span>
				<select id="quality">
					<option value="high" selected>High</option>
					<option value="balanced">Balanced</option>
					<option value="small">Smaller file</option>
				</select>
			</label>
			<label class="field">
				<span>File name (optional)</span>
				<input type="text" id="pdf-name" maxlength="80" placeholder="images" autocomplete="off" />
			</label>
		</div>
	</div>

	<div class="actions">
		<button type="button" class="btn" id="make-btn" disabled>Make PDF</button>
		<button type="button" class="btn btn-secondary hidden" id="clear-btn">Clear all</button>
	</div>

	<p class="status" id="status" role="status" aria-live="polite"></p>
	<ul class="results" id="results"></ul>
</ToolPage>

<script>
	import '../scripts/images-to-pdf';
</script>
