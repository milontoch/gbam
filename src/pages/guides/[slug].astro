---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getGuides, guideUrl, longDate, readingMinutes } from '../../data/guides';
import { tools } from '../../data/tools';
import { site } from '../../data/site';

export async function getStaticPaths() {
	const guides = await getGuides();
	return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const d = guide.data;

const tool = d.tool ? tools.find((t) => t.slug === d.tool && t.live) : undefined;
const related = (await getGuides()).filter((g) => g.id !== guide.id).slice(0, 3);

const url = new URL(guideUrl(guide), Astro.site).href;
const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: d.title,
	description: d.description,
	datePublished: d.published.toISOString(),
	dateModified: d.updated.toISOString(),
	mainEntityOfPage: url,
	image: new URL('/og.png', Astro.site).href,
	author: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
	publisher: {
		'@type': 'Organization',
		name: site.name,
		logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).href },
	},
};
const crumbsLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: site.name, item: new URL('/', Astro.site).href },
		{ '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: d.title, item: url },
	],
};
const ld = (obj: object) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<Base title={`${d.title} | ${site.name}`} description={d.description}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={ld(articleLd)}></script>
		<script type="application/ld+json" set:html={ld(crumbsLd)}></script>
	</Fragment>

	<div class="container">
		<article class="prose page guide">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a> <span aria-hidden="true">›</span> <a href="/guides">Guides</a>
			</nav>
			<h1>{d.title}</h1>
			<p class="muted guide-meta">
				Updated {longDate(d.updated)} · {readingMinutes(guide)} min read
			</p>

			<Content />

			{
				tool && (
					<aside class="try-tool">
						<h2>Try it now</h2>
						<ToolCard tool={tool} />
					</aside>
				)
			}

			{
				d.sources.length > 0 && (
					<section class="sources">
						<h2>Sources and further reading</h2>
						<ul>
							{d.sources.map((s) => (
								<li>
									<a href={s.url}>{s.label}</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				related.length > 0 && (
					<section class="related">
						<h2>More guides</h2>
						<ul>
							{related.map((g) => (
								<li>
									<a href={guideUrl(g)}>{g.data.title}</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</article>
	</div>
</Base>
