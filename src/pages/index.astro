---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import PrivacyBadge from '../components/PrivacyBadge.astro';
import { tools } from '../data/tools';
import { getGuides, guideUrl } from '../data/guides';

const latestGuides = (await getGuides()).slice(0, 3);

const home = new URL('/', Astro.site).href;
const siteLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', '@id': `${home}#website`, url: home, name: 'HandyQuill', inLanguage: 'en' },
		{ '@type': 'Organization', '@id': `${home}#org`, name: 'HandyQuill', url: home, logo: new URL('/apple-touch-icon.png', Astro.site).href },
	],
}).replace(/</g, '\\u003c');
---

<Base
	title="HandyQuill – Free Online Tools That Keep Your Files Private"
	description="Free tools for PDFs, images, invoices and CVs. Everything runs in your browser, so your files never leave your device."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={siteLd}></script>
	</Fragment>
	<div class="container">
		<section class="hero">
			<h1>Free tools that keep your files private</h1>
			<p>Merge PDFs, shrink photos, make invoices and CVs. No sign-up, no uploads, and light on data.</p>
		</section>

		<PrivacyBadge />

		<section id="tools">
			<h2>All tools</h2>
			<ul class="grid">
				{
					tools.map((t) => (
						<li>
							<ToolCard tool={t} />
						</li>
					))
				}
			</ul>
		</section>

		{
			latestGuides.length > 0 && (
				<section class="prose">
					<h2>Latest guides</h2>
					<ul>
						{latestGuides.map((g) => (
							<li>
								<a href={guideUrl(g)}>{g.data.title}</a>
							</li>
						))}
					</ul>
					<p>
						<a href="/guides">All guides</a>
					</p>
				</section>
			)
		}

		<section class="prose">
			<h2>Why HandyQuill?</h2>
			<p>
				Most free online tools upload your files to a server you know nothing about. HandyQuill does the work inside your
				own browser, so your documents, photos and details stay on your phone or computer.
			</p>
			<p>It is free to use, needs no account, and is built to stay fast on slow connections.</p>
		</section>
	</div>
</Base>
