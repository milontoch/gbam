---
// The trust message. "files" is for tools that open the visitor's files; "typed" is for tools that only use what is typed in.
interface Props {
	kind?: 'files' | 'typed';
}
const { kind = 'files' } = Astro.props;
---

<div class="privacy-badge" role="note">
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="4" y="11" width="16" height="10" rx="2"></rect>
		<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
	</svg>
	{
		kind === 'typed' ? (
			<span><strong>Nothing you type leaves your device.</strong> Everything is worked out inside your browser. Nothing is sent to us.</span>
		) : (
			<span><strong>Your files never leave your device.</strong> Everything happens inside your browser. Nothing is uploaded to us.</span>
		)
	}
</div>
